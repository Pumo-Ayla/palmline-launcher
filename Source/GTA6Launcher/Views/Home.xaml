<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:Launcher.Layout;assembly=Launcher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        ResizeMode="CanMinimize" Icon="pack://application:,,,/Launcher;component/Assets/Palmline.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#FFF7F5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">


  <Window.Resources>
    <PathGeometry x:Key="controllerOutline" Figures="M8,4 Q11,3 14,5 H21 Q24,3 27,4 Q30,5 31,10 L33,20 Q34,26 29,25 L23,19 H12 L6,25 Q1,26 2,20 L4,10 Q5,5 8,4 Z M8,11 H14 M11,8 V14 M23,10 H24 M26,13 H27"/>
    <DrawingImage x:Key="placeholderCover">
      <DrawingImage.Drawing>
        <GeometryDrawing Geometry="M0,0 H400 V600 H0 Z">
          <GeometryDrawing.Brush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#393440"/><GradientStop Color="#25232C" Offset="1"/></LinearGradientBrush></GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="placeholderLogo">
      <DrawingImage.Drawing>
        <GeometryDrawing Geometry="{StaticResource controllerOutline}"><GeometryDrawing.Pen><Pen Brush="#8B7F96" Thickness="1.4" LineJoin="Round" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
      </DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="launchSettingsCard" TargetType="Border">
      <Setter Property="Width" Value="324"/><Setter Property="Margin" Value="0,0,23,84"/>
      <Setter Property="Padding" Value="18,15"/><Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="#FC29252D"/><Setter Property="BorderBrush" Value="#65675C6D"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="renderSegments" TargetType="Border">
      <Setter Property="Background" Value="#211E25"/><Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="3"/><Setter Property="Margin" Value="0,4,0,10"/>
    </Style>
    <Style x:Key="renderSegment" TargetType="RadioButton" BasedOn="{StaticResource settingsTab}">
      <Setter Property="Height" Value="29"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#D0C8D5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="chip" CornerRadius="6" Padding="7,0" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="Background" Value="#38313E"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="chip" Property="Background" Value="#50425E"/>
            <Setter Property="Foreground" Value="#FFF7FF"/><Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="panelSurface" Color="#24232C"/>
    <SolidColorBrush x:Key="previewActive" Color="#795578"/>
    <SolidColorBrush x:Key="previewTool" Color="#ED302A39"/>
    <Style x:Key="previewLine" TargetType="Border">
      <Setter Property="Height" Value="9"/><Setter Property="CornerRadius" Value="4"/><Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Background" Value="#E6D7C4DC"/><Setter Property="Margin" Value="0,7,0,5"/>
    </Style>
    <Style x:Key="previewAwardTile" TargetType="Border">
      <Setter Property="Width" Value="{x:Static layout:AchievementTile.CompactWidth}"/><Setter Property="Height" Value="{x:Static layout:AchievementTile.CompactWidth}"/>
      <Setter Property="CornerRadius" Value="10"/><Setter Property="Margin" Value="1,0,6,0"/><Setter Property="Background" Value="#DB403C46"/>
    </Style>
    <LinearGradientBrush x:Key="sunset" StartPoint="0,.5" EndPoint="1,.5">
      <GradientStop Color="#976BFF"/><GradientStop Color="#DE51BE" Offset=".48"/>
      <GradientStop Color="#FF448C" Offset=".78"/><GradientStop Color="#FF726D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="sunsetType" StartPoint="0,.5" EndPoint="1,.5">
      <GradientStop Color="#D7C4FF"/><GradientStop Color="#FFA6DB" Offset=".6"/><GradientStop Color="#FFB6A8" Offset="1"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="saveIcon" ViewboxUnits="Absolute" Viewbox="0,0,24,24">
      <DrawingBrush.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#493B50" Geometry="M0,0 H24 V24 H0 Z"/>
        <GeometryDrawing Brush="{StaticResource sunsetType}" Geometry="M7,5 H17 V20 L12,16.5 7,20 Z"/>
      </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="cardCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#BAB4C5"/><Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="cardValue" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,4,8,0"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <DataTemplate x:Key="achievementTile">
      <layout:AchievementTile Name="tile" UseLayoutRounding="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,0,6,0" Cursor="Hand" AutomationProperties.Name="{Binding Detail}">
        <Grid Height="{x:Static layout:AchievementTile.CompactWidth}">
          <Border Background="{Binding DetailSurface}" CornerRadius="10"/>
          <Grid Margin="78,0,0,0" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <StackPanel MaxWidth="225" Margin="11,0,10,0" VerticalAlignment="Center" TextElement.Foreground="{Binding DetailInk}">
                <TextBlock Name="detailTitle" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,25,0" TextWrapping="Wrap"/>
                <TextBlock Name="description" Text="{Binding Description}" FontSize="11" Margin="0,1,25,0" Opacity=".94" TextWrapping="Wrap"/>
                <TextBlock Name="completion" Text="{Binding Completion}" FontSize="10" Margin="0,2,0,0" Opacity=".86"/>
              </StackPanel>
            </StackPanel>
          </Grid>
      <Border Name="rim" Width="{x:Static layout:AchievementTile.CompactWidth}" HorizontalAlignment="Left" CornerRadius="10" Padding="3"
              Background="{Binding Cover.Value}" RenderOptions.BitmapScalingMode="HighQuality"
              AutomationProperties.Name="{Binding Detail}">
        <Grid Margin="2,0,1,1" VerticalAlignment="Bottom">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="19"/></Grid.ColumnDefinitions>
          <TextBlock Name="title" VerticalAlignment="Center" Text="{Binding Title}" Opacity="{Binding CaptionOpacity,ElementName=tile}" Foreground="#FFF7F5" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,1,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
          <Viewbox Name="badge" Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="{Binding BadgeMargin,ElementName=tile}" IsHitTestVisible="False">
            <Grid Width="24" Height="24" UseLayoutRounding="False">
              <Path Name="ring" Data="M12,1 A11,11 0 1 1 12,23 A11,11 0 1 1 12,1" Stroke="#85808B" StrokeThickness="2" StrokeDashArray="35 37"/>
              <Path Name="progressArc" Data="{Binding ProgressArc}" Stroke="#F6F3F8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <TextBlock Name="percent" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Status}" Foreground="#F6F3F8" FontSize="9.5" FontWeight="SemiBold"/>
              <Path Name="check" Visibility="Collapsed" Data="M7.5,12 L10.7,15.3 16.8,8.8" Stroke="{Binding Finish}" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeDashArray="7 9" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </Viewbox>
        </Grid>
      </layout:AchievementTile>
      <DataTemplate.Triggers><DataTrigger Binding="{Binding Earned}" Value="True">
        <Setter TargetName="rim" Property="Padding" Value="0"/>
        <Setter TargetName="rim" Property="BorderThickness" Value="3"/>
        <Setter TargetName="rim" Property="BorderBrush" Value="{Binding Finish}"/>
        <Setter TargetName="ring" Property="Stroke" Value="{Binding Finish}"/>
        <Setter TargetName="percent" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="check" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsExpanded,ElementName=tile}" Value="True">
        <Setter TargetName="percent" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="progressArc" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="ring" Property="Stroke" Value="#A7A6AA"/>
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsExpanded,ElementName=tile}" Value="True"/>
          <Condition Binding="{Binding Earned}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter TargetName="ring" Property="Stroke" Value="{Binding DetailInk}"/>
        <Setter TargetName="check" Property="Stroke" Value="{Binding DetailInk}"/>
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsExpanded,ElementName=tile}" Value="True"/>
          <Condition Binding="{Binding Earned}" Value="True"/>
          <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions><BeginStoryboard Name="drawBadge"><Storyboard>
          <DoubleAnimation Storyboard.TargetName="ring" Storyboard.TargetProperty="StrokeDashOffset" From="35" To="0" Duration="0:0:0.24" FillBehavior="Stop"/>
          <DoubleAnimationUsingKeyFrames Storyboard.TargetName="check" Storyboard.TargetProperty="StrokeDashOffset" FillBehavior="Stop">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="8"/><DiscreteDoubleKeyFrame KeyTime="0:0:0.24" Value="8"/>
            <SplineDoubleKeyFrame KeyTime="0:0:0.40" Value="0" KeySpline=".2,0,.3,1"/>
          </DoubleAnimationUsingKeyFrames>
        </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
        <MultiDataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="drawBadge"/></MultiDataTrigger.ExitActions>
      </MultiDataTrigger></DataTemplate.Triggers>
    </DataTemplate>
    <ControlTemplate x:Key="coverToggleFace" TargetType="Button">
      <Grid>
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CommonStates">
            <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15"/></VisualStateGroup.Transitions>
            <VisualState x:Name="Normal"/>
            <VisualState x:Name="MouseOver"><Storyboard>
              <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To=".16" Duration="0"/>
            </Storyboard></VisualState>
            <VisualState x:Name="Pressed"><Storyboard>
              <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To=".24" Duration="0"/>
            </Storyboard></VisualState>
            <VisualState x:Name="Disabled"/>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Ellipse Fill="Transparent"/>
        <Grid Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="False" IsHitTestVisible="False">
          <Ellipse x:Name="disc" Fill="{TemplateBinding Background}">
            <Ellipse.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="3" Direction="270" Opacity=".52" Color="#170E20"/></Ellipse.Effect>
          </Ellipse>
          <Ellipse x:Name="shine" Fill="White" Opacity="0"/>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </ControlTemplate>
  </Window.Resources>
  <Viewbox Stretch="Uniform">
  <Border Name="ShellGlass" Width="1160" Height="680" CornerRadius="23" Padding="11" BorderThickness="1" BorderBrush="#597E757C">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3A79A9F"/><GradientStop Color="#8E655F68" Offset=".48"/><GradientStop Color="#A4837679" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid Name="ShellContents">
    <Grid Name="LauncherContent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Name="RailShadow" CornerRadius="16" Background="#FF1E1D20" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect Color="#271A1B" BlurRadius="9" ShadowDepth="2" Opacity=".55"/></Border.Effect>
      </Border>
      <Grid Name="Rail">
        <Grid Name="RailContent" Background="#FF1E1D20">
          <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
          <Ellipse Name="RepositoryGlow" Width="68" Height="68" Margin="0,6,0,0" IsHitTestVisible="False" Visibility="Collapsed">
            <Ellipse.Fill><RadialGradientBrush>
              <GradientStop Color="#DC82EEA7" Offset=".65"/><GradientStop Color="#B874EBA0" Offset=".70"/>
              <GradientStop Color="#5071E397" Offset=".80"/><GradientStop Color="#1671E397" Offset=".91"/>
              <GradientStop Color="#0071E397" Offset="1"/>
            </RadialGradientBrush></Ellipse.Fill>
          </Ellipse>
          <Button Name="Repository" Width="52" Height="52" Margin="0,6,0,0" Padding="0" Style="{StaticResource railAction}" VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{DynamicResource 'ui.启动器仓库 · Pumo-Ayla/series-relay-launcher'}" AutomationProperties.Name="{DynamicResource 'ui.打开启动器的 GitHub 仓库'}">
            <Button.Template><ControlTemplate TargetType="Button">
              <Grid Background="Transparent">
                <Ellipse Width="48" Height="48" Fill="{Binding Background,ElementName=RailContent}"/>
                <Ellipse x:Name="hover" Width="48" Height="48" Fill="White" Opacity="0"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To=".10" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                  <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Button.Template>
            <Viewbox Width="31" Height="31"><Path Fill="White" Data="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"/></Viewbox>
          </Button>
          <DockPanel Grid.Row="1" Name="LibraryRail">
          <Button Name="AddGame" DockPanel.Dock="Bottom" Width="38" Height="38" Margin="0,8,0,8"
                  Style="{StaticResource railAction}" HorizontalAlignment="Center"
                  ToolTip="{DynamicResource 'ui.载入游戏本体'}" AutomationProperties.Name="{DynamicResource 'ui.载入游戏本体'}">
            <Path Data="M1,9 H17 M9,1 V17" Stroke="#DFDAE4" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" VerticalContentAlignment="Center">
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Name="GameList"/>
            <Grid Name="ImportRailSlot" Grid.Row="1" Width="72" Height="0" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
              <Grid Name="ImportRailIcon" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"
                    AutomationProperties.Name="{DynamicResource 'ui.等待识别游戏'}">
                <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="ImportRailScale"/><TranslateTransform Y="-3"/></TransformGroup></Grid.RenderTransform>
                <Border Width="46" Height="46" CornerRadius="8" Background="#F1EBF4" IsHitTestVisible="False">
                  <Border.Effect><BlurEffect Radius="5"/></Border.Effect>
                </Border>
                <Border Name="DraftRailFace" Width="40" Height="40" CornerRadius="6" Visibility="Collapsed">
                  <Border.Background><ImageBrush ImageSource="{Binding Source,ElementName=IconPreview}" Stretch="UniformToFill"/></Border.Background>
                  <TextBlock Text="{Binding Text,ElementName=IconInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="White"/>
                </Border>
                <StackPanel Name="ImportRailDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse Width="5.5" Height="5.5" Margin="2" Fill="#E8D8F3"/>
                  <Ellipse Width="5.5" Height="5.5" Margin="2" Fill="#E8D8F3"/>
                  <Ellipse Width="5.5" Height="5.5" Margin="2" Fill="#E8D8F3"/>
                </StackPanel>
              </Grid>
            </Grid>
            <Border Name="SelectionMark" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                    Width="6" Height="24" CornerRadius="3" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
          </Grid>
          </ScrollViewer>
          </DockPanel>
          <Button Grid.Row="2" Name="ControllerArea" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Padding="0" Cursor="Hand" FocusVisualStyle="{StaticResource navFocus}" AutomationProperties.Name="{DynamicResource 'ui.查看 Xbox 手柄'}">
            <Button.Template><ControlTemplate TargetType="Button">
              <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </ControlTemplate></Button.Template>
            <Grid Width="48" Height="48" IsHitTestVisible="False">
              <Ellipse Name="ModeHover" Width="40" Height="40" Fill="#38373B">
                <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0"/>
                  <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver,ElementName=ControllerArea}" Value="True"><Setter Property="Opacity" Value=".42"/></DataTrigger></Style.Triggers>
                </Style></Ellipse.Style>
              </Ellipse>
              <Ellipse Name="ViewerDisc" Width="38" Height="38" Fill="#323236" Opacity="0">
                <Ellipse.Effect>
                  <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="11" Opacity=".72"/>
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse Name="ModeRing" Width="42" Height="42" Stroke="#EFDAF6F3" StrokeThickness="1.25" StrokeDashArray="105,105" StrokeDashOffset="105" Visibility="Collapsed" RenderTransformOrigin=".5,.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
              </Ellipse>
              <Viewbox Name="PadGlyph" Width="26" Height="19" RenderTransformOrigin=".5,.5"><Path Stroke="#FAF9F8" StrokeThickness="1.65" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M6,2 C3,1.5 2,4 1,10 C0,15 2,17 5,14 L8,11.5 H16 L19,14 C22,17 24,15 23,10 C22,4 21,1.5 18,2 Q12,3.5 6,2 Z M5,7 H9 M7,5 V9 M16,7 h.3 M19,5.5 h.3"/></Viewbox>
              <Grid Name="KeyboardGlyph" Width="24" Height="16" Visibility="Collapsed" RenderTransformOrigin=".5,.5">
                <Border BorderBrush="#FAF9F8" BorderThickness="1.5" CornerRadius="3"/>
                <Path Stroke="#FAF9F8" StrokeThickness="1.4" Data="M4,5 H6 M8,5 H10 M12,5 H14 M16,5 H19 M4,8 H6 M8,8 H10 M12,8 H14 M16,8 H19 M7,11 H17"/>
              </Grid>
              <Ellipse Name="ControllerLight" Width="6" Height="6" Stroke="#FF252428" StrokeThickness="1" Fill="#AAA5AA"
                       HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.RenderTransform><TranslateTransform X="13" Y="8.5"/></Ellipse.RenderTransform></Ellipse>
            </Grid>
          </Button>
        </Grid>
        <Border Background="#7508060D" IsHitTestVisible="False" Visibility="{Binding Visibility, ElementName=SettingsPanel}"/>
      </Grid>
      <Grid Name="ImportSplit" Grid.Column="2" Width="0" Visibility="Collapsed" ClipToBounds="True">
        <Grid Name="ImportSurface" Margin="0,0,8,0" VerticalAlignment="Bottom" Height="6" Opacity="0" Background="{StaticResource panelSurface}">
          <Grid Name="ImportContext" ClipToBounds="True">
            <Grid Name="DetailCardHost">
            <Grid Name="PreviewCardFrame" ClipToBounds="True" Visibility="Collapsed">
            <Grid Name="PreviewArt" ClipToBounds="True">
            <Image Name="ImportCoverPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle IsHitTestVisible="False"><Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00231A2A" Offset=".48"/><GradientStop Color="#95231A2A" Offset=".62"/><GradientStop Color="#D91E1726" Offset=".76"/><GradientStop Color="#ED1A1423" Offset="1"/></LinearGradientBrush>
            </Rectangle.Fill></Rectangle>
            <Canvas Name="PreviewLogoArea" Background="Transparent" ClipToBounds="True">
              <Image Name="PreviewLogo" Stretch="Uniform" Cursor="SizeAll" ToolTip="{DynamicResource 'ui.拖动 Logo 移动，拖动角点缩放。'}"/>
              <Border Name="ResizeLogo" Width="12" Height="12" Background="#EEE1F6" BorderBrush="#593B70" BorderThickness="2" CornerRadius="3" Cursor="SizeNWSE"/>
              <Rectangle Name="SnapVertical" Fill="#B5E8D3" Width="1" Visibility="Collapsed" IsHitTestVisible="False"/>
              <Rectangle Name="SnapHorizontal" Fill="#B5E8D3" Height="1" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Canvas>
            </Grid>
            <StackPanel Name="PreviewSummary" Margin="18,0,18,18" VerticalAlignment="Bottom" IsHitTestVisible="False">
              <Grid MinHeight="36" Margin="0,0,46,0">
                <TextBlock Name="PreviewGameName" Text="{Binding Text,ElementName=ImportName}" VerticalAlignment="Center" FontSize="23" Foreground="#FFF7F5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </Grid>
              <Grid Margin="1,8,0,0" MinHeight="36">
                <StackPanel Name="PreviewRecord" Orientation="Horizontal" VerticalAlignment="Center">
                  <Path Width="10" Height="10" VerticalAlignment="Center" Stretch="Uniform" Fill="{StaticResource sunsetType}" Data="M5,0 C5.7,3.2 6.8,4.3 10,5 C6.8,5.7 5.7,6.8 5,10 C4.3,6.8 3.2,5.7 0,5 C3.2,4.3 4.3,3.2 5,0 Z"/>
                  <TextBlock Margin="7,0,0,0" Text="{DynamicResource 'ui.崭新出厂'}" Foreground="{StaticResource sunsetType}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <Grid Name="PreviewStats" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="73"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{DynamicResource 'ui.游玩进度'}" Style="{StaticResource cardCaption}"/><Border Width="90" Style="{StaticResource previewLine}"/></StackPanel>
                  <Border Grid.Column="1" BorderBrush="#48DBCDDA" BorderThickness="1,0,0,0" Padding="12,0"><StackPanel><TextBlock Text="{DynamicResource 'ui.游玩时长'}" Style="{StaticResource cardCaption}"/><Border Width="43" Style="{StaticResource previewLine}"/></StackPanel></Border>
                  <Border Grid.Column="2" BorderBrush="#48DBCDDA" BorderThickness="1,0,0,0" Padding="12,0,0,0"><StackPanel><TextBlock Text="{DynamicResource 'ui.上次启动'}" Style="{StaticResource cardCaption}"/><Border Width="108" Style="{StaticResource previewLine}"/></StackPanel></Border>
                </Grid>
              </Grid>
              <StackPanel Name="PreviewShelf" Visibility="Collapsed" Margin="0,13,0,0">
