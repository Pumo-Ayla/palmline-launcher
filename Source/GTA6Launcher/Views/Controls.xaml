<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="navFocus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Grid IsHitTestVisible="False" Visibility="{DynamicResource KeyboardCueVisibility}">
        <Border Width="12" Height="2" CornerRadius="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1" Background="#F8DCAC"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="licenseLabel">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#F2EFF4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
        <Run Text="{Binding Name,Mode=OneWay}"/><Run FontSize="10" Foreground="#ADA6B2" Text="{Binding Version,Mode=OneWay}"/>
      </TextBlock>
      <Border x:Name="badge" Grid.Column="1" VerticalAlignment="Center" Margin="7,0" CornerRadius="4" Padding="6,2" Background="#37323D">
        <TextBlock Text="{Binding Label}" Foreground="#D4CADD" FontSize="10" VerticalAlignment="Center"/>
      </Border>
      <Path x:Name="arrow" Grid.Column="2" Data="M1,1 L5,5 L9,1" Stroke="#AFA7B8" StrokeThickness="1.3" StrokeLineJoin="Round"
            HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Label}" Value=""><Setter TargetName="badge" Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding IsExpanded,RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
        <Setter TargetName="arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
      </DataTrigger>
      <DataTrigger Binding="{Binding External}" Value="True"><Setter TargetName="arrow" Property="Data" Value="M1,9 L9,1 M3,1 L9,1 9,7"/></DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="licenseRowButton" TargetType="ButtonBase">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/>
    <Setter Property="MinHeight" Value="34"/><Setter Property="ContentTemplate" Value="{StaticResource licenseLabel}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
      <Border x:Name="row" CornerRadius="5" Background="Transparent" Padding="10,5">
        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#353038"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="row" Property="Background" Value="#413847"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="licenseEntry" TargetType="Expander">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
      <StackPanel>
        <ToggleButton x:Name="HeaderSite" Style="{StaticResource licenseRowButton}" Content="{TemplateBinding Header}"
                      AutomationProperties.Name="{Binding Header.Name,RelativeSource={RelativeSource TemplatedParent}}"
                      IsChecked="{Binding IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"/>
        <Border x:Name="body" Visibility="Collapsed" Background="#1D1B20" CornerRadius="5" Margin="5,0,5,6" Padding="8">
          <ContentPresenter/>
        </Border>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="body" Property="Visibility" Value="Visible"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}"/>
    <Setter Property="Background" Value="#F229252F"/>
    <Setter Property="Foreground" Value="#FFF5F3"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Padding" Value="13,9"/>
    <Setter Property="HorizontalOffset" Value="5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Margin="5,4,5,7" Padding="{TemplateBinding Padding}" CornerRadius="11"
              Background="#FA29262C" BorderThickness="1" BorderBrush="#486E6872">
        <Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="2" Opacity=".32"/></Border.Effect>
        <ContentPresenter/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/>
    <Setter Property="Background" Value="#DF28232E"/>
    <Setter Property="Foreground" Value="#FFF7FA"/>
    <Setter Property="BorderBrush" Value="#387F7580"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="5"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <Border x:Name="wash" CornerRadius="5" Background="White" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Opacity" Value="0.13"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="wash" Property="Opacity" Value="0.24"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.58"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="railAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <Border Name="wash" CornerRadius="24" Background="White" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Opacity" Value=".11"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="wash" Property="Opacity" Value=".32"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="roundAction" TargetType="Button" BasedOn="{StaticResource railAction}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Ellipse Name="circle" Fill="{TemplateBinding Background}">
          <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity=".3"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Name="wash" Fill="White" Opacity="0"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Opacity" Value=".17"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="wash" Property="Opacity" Value=".28"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="windowButton" TargetType="Button" BasedOn="{StaticResource roundAction}">
    <Setter Property="Height" Value="37"/><Setter Property="Width" Value="37"/><Setter Property="Margin" Value="4,0"/>
    <Setter Property="Background" Value="#FC242125"/>
  </Style>
  <Style x:Key="toolbarButton" TargetType="Button" BasedOn="{StaticResource windowButton}">
    <Setter Property="Background" Value="#1C1B1E"/>
    <Setter Property="BorderBrush" Value="#32FFFFFF"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Ellipse Name="surface" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness=".65">
          <Ellipse.Effect><DropShadowEffect Color="#100E13" Direction="270" BlurRadius="6" ShadowDepth="2" Opacity=".44"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse Name="wash" Margin=".65" Fill="White" Opacity="0" IsHitTestVisible="False"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Stroke" Value="#50FFFFFF"/><Setter TargetName="wash" Property="Opacity" Value=".12"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="wash" Property="Opacity" Value=".20"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="profileMenu" TargetType="ContextMenu">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border CornerRadius="10" Background="#28272D" Padding="4" BorderBrush="#49454F" BorderThickness="1"><ItemsPresenter/></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
        <Border x:Name="item" CornerRadius="7" Background="Transparent" Padding="13,7">
          <ContentPresenter ContentSource="Header"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="item" Property="Background" Value="#49464F"/>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
  </Style>
  <DrawingBrush x:Key="viceCitySlot" Viewbox="0,0,64,64" ViewboxUnits="Absolute" Stretch="Fill">
    <DrawingBrush.Drawing><DrawingGroup>
      <GeometryDrawing Geometry="M0,0 H64 V64 H0 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint=".62,0" EndPoint=".38,.83">
            <GradientStop Offset="0" Color="#382864"/>
            <GradientStop Offset=".35" Color="#79467F"/>
            <GradientStop Offset=".67" Color="#C46387"/>
            <GradientStop Offset=".88" Color="#ED8B88"/>
            <GradientStop Offset="1" Color="#FFB98C"/>
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Brush="#FFD59F"><GeometryDrawing.Geometry>
        <EllipseGeometry Center="14,42" RadiusX="7" RadiusY="7"/>
      </GeometryDrawing.Geometry></GeometryDrawing>
      <GeometryDrawing Brush="#84547A" Geometry="M0,47 L5,46 10,46 12,45 20,45 23,46 30,46 32,44 34,44 34,42 37,42 37,45 41,45 41,41 43,41 43,39 45,39 45,41 47,41 47,45 51,45 54,46 64,44 V50 H0 Z"/>
      <GeometryDrawing Geometry="M0,48 Q15,47 32,48 T64,47 V64 H0 Z">
        <GeometryDrawing.Brush>
          <LinearGradientBrush StartPoint="0,0" EndPoint=".15,1">
            <GradientStop Offset="0" Color="#A45C82"/><GradientStop Offset=".38" Color="#684577"/>
            <GradientStop Offset="1" Color="#342C56"/>
          </LinearGradientBrush>
        </GeometryDrawing.Brush>
      </GeometryDrawing>
      <GeometryDrawing Brush="#F5B29D" Geometry="M7,49 H21 L16,50 H8 Z M10,51.6 H19 L13,52.5 Z M6,54 H14 L11,54.8 Z"/>
      <!-- One cropped palm keeps the shoreline legible at the 47-DIP tile size. -->
      <GeometryDrawing Brush="#483051" Geometry="M64,53 C60,39 58,23 55,13 C57,21 58,40 60,54 L64,56 Z
        M55,14 C49,9 43,11 39,16 Q45,13 49,14 L48,13 Q52,13 55,15 Z
        M55,14 C50,13 44,17 42,23 Q46,19 49,18 L48,19 Q52,16 55,15 Z
        M55,14 C49,7 44,6 39,7 Q45,8 48,11 L47,9 Q51,11 55,15 Z
        M55,14 C53,7 55,2 57,0 Q56,5 57,7 L56,7 Q55,11 56,14 Z
        M55,14 C58,8 63,7 64,7 V9 Q60,10 56,15 Z
        M55,14 Q61,11 64,14 V17 Q60,15 58,15 L60,17 Z
        M55,14 Q62,16 63,24 Q60,20 58,19 L59,21 Q57,17 55,15 Z"/>
    </DrawingGroup></DrawingBrush.Drawing>
  </DrawingBrush>
  <PathGeometry x:Key="gtaViMark" Figures="M0,0 H11 L15,9 19,0 H30 L15,32 Z M31,0 H42 V32 H31 Z"/>
  <LinearGradientBrush x:Key="presetCaptionTint" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#534155" Offset="0"/><GradientStop Color="#3C3446" Offset=".54"/>
    <GradientStop Color="#333239" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="mappingTile" TargetType="Button" BasedOn="{StaticResource railAction}">
    <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Name="face" Background="Transparent" RenderTransformOrigin=".5,.5">
        <Border Name="glow" CornerRadius="11" Background="White" Margin="1" Opacity="0">
          <Border.Effect><DropShadowEffect Color="#F2E9FF" BlurRadius="12" ShadowDepth="0" Opacity=".94"/></Border.Effect>
        </Border>
        <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
        <Border Name="glint" CornerRadius="10" Background="#EAE0FA" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="glint" Property="Opacity" Value=".12"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="glint" Property="Opacity" Value=".20"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="bindingCapsule" TargetType="Button" BasedOn="{StaticResource railAction}">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border Name="face" CornerRadius="23" Background="{TemplateBinding Background}" RenderTransformOrigin=".5,.5">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <BooleanToVisibilityConverter x:Key="whenChecked"/>
  <PathGeometry x:Key="settingsGear" FillRule="EvenOdd" Figures="M10,1 L14,1 14.7,3.8 16.2,4.5 18.7,3.1 21,5.4 19.7,8 20.4,9.6 23,10.2 23,13.8 20.4,14.5 19.7,16 21,18.6 18.7,20.9 16.2,19.5 14.7,20.2 14,23 10,23 9.3,20.2 7.8,19.5 5.3,20.9 3,18.6 4.3,16 3.6,14.5 1,13.8 1,10.2 3.6,9.6 4.3,8 3,5.4 5.3,3.1 7.8,4.5 9.3,3.8 Z M16.3,12 A4.3,4.3 0 1 0 7.7,12 A4.3,4.3 0 1 0 16.3,12 Z"/>
  <Style x:Key="settingsCard" TargetType="Border">
    <Setter Property="Background" Value="#FF252428"/><Setter Property="CornerRadius" Value="9"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style x:Key="settingsTab" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="36"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#FFAAA5AE"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border Name="surface" Background="Transparent" CornerRadius="7" Padding="13,0">
        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="surface" Property="Background" Value="#FF302D33"/></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="surface" Property="Background" Value="#FF454247"/><Setter Property="Foreground" Value="White"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="languageChoice" TargetType="RadioButton" BasedOn="{StaticResource settingsTab}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="settingsCheck" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <DockPanel Background="Transparent">
        <Border Name="box" Width="16" Height="16" Margin="0,0,7,0" CornerRadius="4" VerticalAlignment="Center"
                BorderThickness="1" BorderBrush="Transparent" Background="#FF57545B">
          <Path Name="mark" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FF232228"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,5 L4,8 10,1"/>
        </Border>
        <ContentPresenter VerticalAlignment="Center"/>
      </DockPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="box" Property="Background" Value="#FFF2ECA6"/><Setter TargetName="mark" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#DDFFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="emulatorOption" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="10,7">
        <DockPanel>
          <Path x:Name="tick" DockPanel.Dock="Right" Margin="9,0,2,0" VerticalAlignment="Center" Opacity="0"
                Data="M1,6 L5,10 12,2" Stroke="#A5EDBE" StrokeThickness="1.8" StrokeLineJoin="Round"/>
          <Border DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" CornerRadius="5" Background="{TemplateBinding Background}"/>
          <ContentPresenter VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="tick" Property="Opacity" Value="1"/><Setter TargetName="row" Property="Background" Value="#363238"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="#464047"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource navFocus}"/>
    <Setter Property="Width" Value="72"/><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="0,2"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="RadioButton">
        <Grid Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".65"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
